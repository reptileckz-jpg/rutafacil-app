{
  "appId": "com.rutafacil.app",
  "appName": "Ruta Fácil",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
