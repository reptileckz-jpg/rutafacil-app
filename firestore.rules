rules_version = '2';
// Reglas de Ruta Fácil (Plátanos Nietos).
// Quién puede leer y escribir qué. Se pegan en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- ayudantes ----------
    function sesion() { return request.auth != null; }
    function perfilDe(uid) { return get(/databases/$(database)/documents/usuarios_app/$(uid)).data; }
    function existePerfil() { return sesion() && exists(/databases/$(database)/documents/usuarios_app/$(request.auth.uid)); }
    function yo() { return perfilDe(request.auth.uid); }
    function activo() { return existePerfil() && yo().activo == true; }
    function esAdmin() { return activo() && yo().rol == 'admin'; }
    function esDuenio() { return esAdmin() && yo().get('duenio', false) == true; }
    function esContador() { return activo() && yo().rol == 'cont'; }
    // un chofer que el administrador dejó de encargado (hasta cierta fecha)
    function esEncargado() { return activo() && yo().rol == 'chofer' && yo().get('encHasta', 0) > request.time.toMillis(); }
    function mandaComoAdmin() { return esAdmin() || esEncargado(); }

    // ---------- dueño del negocio (se crea una sola vez, al abrir la cuenta) ----------
    match /meta/duenio {
      allow read: if sesion();
      allow create: if sesion() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if esDuenio();
    }

    // ---------- usuario → correo (se lee antes de entrar, para entrar con "usuario") ----------
    match /usuarios/{u} {
      allow get: if true;
      allow list: if esAdmin();
      allow write: if esAdmin();
    }

    // ---------- perfiles (qué papel tiene cada quien) ----------
    match /usuarios_app/{uid} {
      function nuevo() { return request.resource.data; }
      function antes() { return resource.data; }
      allow get: if sesion() && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();
      // el primer perfil: el dueño, justo después de abrir la cuenta del negocio
      allow create: if sesion() && request.auth.uid == uid
                    && get(/databases/$(database)/documents/meta/duenio).data.uid == uid
                    && nuevo().rol == 'admin' && nuevo().duenio == true;
      // los demás los crea un administrador. Un administrador nuevo solo lo crea el dueño;
      // otro administrador solo puede darle "contraseña nueva" a un administrador que ya existe (reemplaza)
      allow create: if esAdmin() && request.auth.uid != uid
                    && nuevo().get('duenio', false) == false
                    && (nuevo().rol != 'admin' || esDuenio()
                        || (nuevo().get('reemplaza', '') != '' && perfilDe(nuevo().reemplaza).rol == 'admin'
                            && perfilDe(nuevo().reemplaza).get('duenio', false) == false));
      // nadie se cambia a sí mismo; el papel no cambia (salvo el dueño); a un administrador
      // otro administrador solo le cierra la sesión o lo reemplaza con su contraseña nueva
      allow update: if esAdmin() && request.auth.uid != uid
                    && nuevo().get('duenio', false) == antes().get('duenio', false)
                    && (nuevo().rol == antes().rol || esDuenio())
                    && (antes().rol != 'admin' || esDuenio()
                        || nuevo().diff(antes()).affectedKeys().hasOnly(['corte'])
                        || (nuevo().diff(antes()).affectedKeys().hasOnly(['activo', 'reemplazo']) && nuevo().activo == false));
      allow delete: if esDuenio() && request.auth.uid != uid;
    }

    // ---------- datos del negocio ----------
    // "s~algo" = compartido, "r~chofer~algo" = de la ruta de un chofer
    match /n/{neg}/d/{id} {
      allow read: if activo();
      // lo delicado solo lo cambia el administrador (o el encargado, o el contador para lo de dinero)
      allow write: if mandaComoAdmin()
                   || (esContador() && !(id in ['s~choferes', 's~usuarios', 's~vehAsig', 's~admins']))
                   || (activo() && request.method != 'delete' && !(id in [
                        's~precio', 's~cfg', 's~pagosSueldo', 's~adelantos', 's~bonos', 's~fijos',
                        's~metaMes', 's~mesCerr', 's~reglas', 's~vehAsig', 's~admins', 's~bods',
                        's~mayP', 's~mayMin', 's~cajaBase', 's~aportes', 's~porPagar', 's~pagoPide',
                        's~enc', 's~vac', 's~bienes', 's~fijosPag',
                        's~cliBase', 's~vacPlan', 's~fac76'
                      ]));
    }
    // fotos (comprimidas); las borra el administrador después de un mes
    match /n/{neg}/f/{id} {
      allow read, create, update: if activo();
      allow delete: if mandaComoAdmin();
    }

    // ubicación de los celulares del negocio (la sube el celular solo, aunque nadie tenga la sesión abierta)
    // la lee el administrador; el celular escribe aunque el chofer ya no esté activo (para no perder el rastro)
    match /n/{neg}/gps/{dev} {
      allow read: if mandaComoAdmin();
      allow create, update: if existePerfil() && request.resource.data.dev == dev;
      allow delete: if mandaComoAdmin();
    }
    match /n/{neg}/gpsp/{id} {
      allow read: if mandaComoAdmin();
      allow create, update: if existePerfil() && id.matches(request.resource.data.dev + '_[0-9]+')
                            && request.resource.data.keys().hasOnly(['dev', 't', 'v']);
      allow delete: if mandaComoAdmin();
    }

    // 132 · avisos push (Firebase Cloud Messaging). El token de cada celular de chofer: lo guarda ese chofer (o el administrador);
    // nadie lo lee desde la app (lo usa la función de la nube con permisos de servidor)
    match /n/{neg}/tok/{ch} {
      allow create, update: if activo()
                            && (mandaComoAdmin() || (yo().rol == 'chofer' && string(yo().get('chId', '')) == ch))
                            && request.resource.data.keys().hasOnly(['t', 'ts'])
                            && request.resource.data.t is string && request.resource.data.t.size() < 400;
      allow read: if false;
      allow delete: if mandaComoAdmin();
    }
    // 148 · errores de la app: cada celular manda los suyos (solo crear); los lee el administrador o el servidor
    match /n/{neg}/err/{id} {
      allow create: if activo()
                    && request.resource.data.keys().hasOnly(['t', 'f', 'h', 'tipo', 'txt', 'donde', 'rol', 'ch', 'web', 'apk'])
                    && request.resource.data.txt is string && request.resource.data.txt.size() <= 300
                    && request.resource.data.donde is string && request.resource.data.donde.size() <= 200;
      allow read, delete: if esAdmin();
      allow update: if false;
    }
    // un aviso para un chofer: solo lo crea el administrador (o el encargado); la función de la nube lo manda y lo borra.
    // 152 · un chofer también puede avisar a los administradores (ch == 'admins'), solo para pedir permiso (fiar, mayoreo, precio)
    match /n/{neg}/push/{id} {
      allow create: if (mandaComoAdmin() || (activo() && request.resource.data.ch == 'admins' && request.resource.data.tipo == 'permiso'))
                    && request.resource.data.keys().hasOnly(['ch', 'titulo', 'texto', 'tipo', 't'])
                    && request.resource.data.ch is string
                    && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 200
                    && request.resource.data.texto is string && request.resource.data.texto.size() <= 1000;
      allow read, update, delete: if false;
    }

    // 25 · resumen para los avisos al administrador (quién tiene clientes cada día, zona horaria, días que dura la fruta madura):
    // lo escribe cualquier celular con la app abierta; lo lee la función de la nube "avisosAdmin". "env" lo escribe solo la función.
    match /n/{neg}/av/plan {
      allow read: if activo();
      allow write: if activo() && request.method != 'delete'
                   && request.resource.data.keys().hasOnly(['v', 'tz', 'vida', 'dias', 'sinCh', 't'])
                   && request.resource.data.tz is string && request.resource.data.tz.size() < 60;
    }
    match /n/{neg}/av/{otro} {
      allow read, write: if false;
    }

    // todo lo demás, cerrado
    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
